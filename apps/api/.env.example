# Server-side only. Never copy this file into the extension or bundle it.
AI_PROVIDER=gemini
AI_API_KEY=
# Choose a vision-capable model supporting Structured Outputs in your account.
AI_MODEL=gemini-3.5-flash-lite
API_PORT=4317

# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste the same local access token into the extension's backend settings.
# This token is separate from the AI provider key and is required (32+ characters).
API_ACCESS_TOKEN=

# Optional: allow only your unpacked extension's 32-character ID.
# Find it at chrome://extensions after loading the extension.
API_EXTENSION_ID=
AI_TIMEOUT_MS=45000
API_RATE_LIMIT_PER_MINUTE=10
API_MAX_CONCURRENT=2

# Alternative: native Ollama Cloud at https://ollama.com/api/chat.
# AI_PROVIDER=ollama
# AI_MODEL=gpt-oss:120b
# AI_API_KEY=your-ollama-cloud-key
# OLLAMA_API_KEY is also accepted when AI_PROVIDER=ollama.
# gpt-oss:120b is text-only: screenshot analysis is rejected before external upload.
# Image analysis needs a model advertising vision in https://ollama.com/api/tags.
# Ollama Cloud currently has no enforced structured outputs; responses are locally validated.

# Alternative: OpenAI Vision
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# AI_API_KEY=your-openai-key
# Gemini can also read GEMINI_API_KEY (or GOOGLE_API_KEY) if AI_API_KEY is empty.
