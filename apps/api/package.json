{
  "name": "@vclarity/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:dotenv/config",
    "start": "node dist/index.js",
    "check:gemini": "tsx scripts/check-gemini.ts",
    "check:vision": "tsx scripts/check-vision.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. apps/api"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.2",
    "@vclarity/shared": "workspace:*",
    "dotenv": "^17.2.3",
    "hono": "^4.10.3",
    "image-size": "^2.0.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": { "esbuild": "^0.25.11" }
}
